{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "boxie",
  "main": "cloudflare/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./dist/web",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/app",
      "/app/",
      "/delete-account",
      "/feedback",
      "/beta",
      "/beta/",
      "/api/beta/*",
      "/beta.html"
    ],
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "boxie.dionlabs.ai",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "BETA_DB",
      "database_name": "boxie-beta",
      "database_id": "0f59134a-52df-4605-8923-58c86521e61a",
      "migrations_dir": "cloudflare/migrations"
    }
  ],
  "vars": {
    "BETA_ENABLED": "true"
  },
  "triggers": {
    "crons": [
      "17 3 * * *"
    ]
  }
}
