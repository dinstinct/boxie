{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "boxie",
  "main": "cloudflare/worker.js",
  "workers_dev": true,
  "compatibility_date": "2026-09-05",
  "assets": {"directory": "./dist/web", "binding": "ASSETS", "run_worker_first": ["/", "/app", "/app/", "/delete-account", "/feedback"]},
  "routes": [{"pattern": "boxie.dionlabs.ai", "custom_domain": true}]
}
